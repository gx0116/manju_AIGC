    <dependencies>
        <!--common-->
        <dependency>
            <groupId>com.hgx</groupId>
            <artifactId>manju-common</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud.ai</groupId>
