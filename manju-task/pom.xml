        <dependency>
            <groupId>com.hgx</groupId>
            <artifactId>manju-api</artifactId>
            <version>0.0.1-SNAPSHOT</version>
        </dependency>
        <!--OK http 的依赖 -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>okhttp</artifactId>
        </dependency>
        <!--web-->
        <dependency>
